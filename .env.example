# Copy to .env and fill in. Never commit .env.
SA_ENV=dev
# Local Postgres URL: printed by `python infra/dev/localpg.py` (or your Docker/native Postgres)
SA_DATABASE_URL=postgresql+psycopg://postgres:@127.0.0.1:5432/seafarer
SA_TEST_DATABASE_URL=postgresql+psycopg://postgres:@127.0.0.1:5432/seafarer_test
SA_DATA_DIR=data
# Contact address sent in the scraper's User-Agent (politeness)
SA_SCRAPER_CONTACT=you@example.com
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SA_JWT_SECRET=change-me
SA_ADMIN_TOKEN=change-me

# Optional outbound email (login codes, alerts, admin alerts). Unset = dev mode logs login codes to console.
SA_SMTP_HOST=
SA_SMTP_PORT=587
SA_SMTP_USER=
SA_SMTP_PASSWORD=
SA_SMTP_FROM=
SA_ADMIN_ALERT_EMAIL=
SA_ADMIN_ALERT_SLACK_WEBHOOK=

# Optional LLM upgrade (not used yet; the pipeline is rules/extractive only)
SA_ANTHROPIC_API_KEY=
