# Production/staging settings for infra/docker-compose.yml. Copy to infra/.env.prod (git-ignored) and fill in.
SA_ENV=prod
SA_DOMAIN=api.example.org
# Generate each: python -c "import secrets;print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
SA_JWT_SECRET=
SA_ADMIN_TOKEN=
# Contact address sent in the scraper's User-Agent (optional, recommended)
SA_SCRAPER_CONTACT=
SA_CORS_ORIGINS=[]

# Outbound email (login codes, alerts). Without SMTP, prod logins cannot work.
SA_SMTP_HOST=
SA_SMTP_PORT=587
SA_SMTP_USER=
SA_SMTP_PASSWORD=
SA_SMTP_FROM=
SA_ADMIN_ALERT_EMAIL=
SA_ADMIN_ALERT_SLACK_WEBHOOK=

# Privacy notice (/privacy). Required before real testers sign up.
SA_OPERATOR_NAME=
SA_PRIVACY_CONTACT=
SA_HOSTING_DESCRIPTION=a cloud server in India
