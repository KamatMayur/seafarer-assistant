# Automatic HTTPS for SA_DOMAIN (use "localhost" for a local test: Caddy then issues a local certificate).
{$SA_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
	# The admin UI is never framed and only loads its own vendored script.
	header /admin* {
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'"
	}

	reverse_proxy api:8000
}
